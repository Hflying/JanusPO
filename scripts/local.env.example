# 复制为 local.env 后填写，并在训练前执行: set -a && source scripts/local.env && set +a
# （不要把含密钥的 local.env 提交到 git）

# 必填：HF 格式模型目录（Qwen 等）
export ARPO_ACTOR_MODEL_PATH="/path/to/your/model"

# PyTorch 2.6 + 新 Triton 在部分环境下需关闭 Dynamo 才能正常 import vLLM（脚本里默认已处理）。
# 若要强制开启 torch.compile / dynamo：export ARPO_ENABLE_TORCH_COMPILE=1

# 暂不接 Bright Data 时设为 1，使用 MockSearchTool（无真实搜索结果，仅跑通流程）
# export ARPO_USE_MOCK_SEARCH=1

# 联网搜索（Bright Data Bing 等）；与 Mock 二选一
export ARPO_SEARCH_API_KEY=""
export ARPO_SEARCH_ZONE=""

# 可选：conda 根目录与 env 名（与 Python 工具子进程一致）
# export ARPO_CONDA_BASE="/home/ubuntu/miniconda3"
# export ARPO_CONDA_ENV="arpo"

# 可选：W&B
# export WANDB_API_KEY=""
